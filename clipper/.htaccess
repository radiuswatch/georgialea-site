# ClipNow on Bluehost (Apache)

# Always use HTTPS: phone Save/Share, screen-awake and add-to-home-screen need it
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# The Studio page: clipnow.vip/studio is the same app file, showing only the Studio
RewriteRule ^studio/$ /studio [L,R=301]
RewriteRule ^studio$ index.html [L]
RewriteRule ^campaigns/$ /campaigns [L,R=301]
RewriteRule ^campaigns$ index.html [L]
RewriteRule ^stats/$ /stats [L,R=301]
RewriteRule ^stats$ index.html [L]

# Serve the app manifest with the right type
AddType application/manifest+json .webmanifest

# Don't cache the page itself so updates show up right away; cache icons for a week
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # The offline helper must be re-checked on every visit so app updates reach phones
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.png$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
