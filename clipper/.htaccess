# ClipNow on Bluehost (Apache)

# Always use HTTPS: phone Save/Share, screen-awake and add-to-home-screen need it
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Coming-soon mode: while there's no "site-live.on" file in this folder, the public pages show
# coming-soon.html instead. Switch it in the admin portal (Site status). The admin portal, the API,
# images and the policy pages are not affected. A browser with the cn_preview=1 cookie (set from the
# admin portal) sees the real site.
RewriteCond %{REQUEST_FILENAME} ^(.*/)[^/]*$
RewriteCond %1site-live.on !-f
RewriteCond %{HTTP_COOKIE} !(^|;\s*)cn_preview=1(;|$)
RewriteRule ^(index\.html|studio/?|campaigns/?|stats/?|affiliates/?)?$ coming-soon.html [L]

# Clipper U episode share page: clipnow.vip/clipper-u (always public, even in coming-soon mode)
RewriteRule ^clipper-u/?$ clipper-u.html [L]

# The Studio page: clipnow.vip/studio is the same app file, showing only the Studio
RewriteRule ^studio/$ /studio [L,R=301]
RewriteRule ^studio$ index.html [L]
RewriteRule ^campaigns/$ /campaigns [L,R=301]
RewriteRule ^campaigns$ index.html [L]
RewriteRule ^stats/$ /stats [L,R=301]
RewriteRule ^stats$ index.html [L]
RewriteRule ^affiliates/$ /affiliates [L,R=301]
RewriteRule ^affiliates$ index.html [L]

# Serve the app manifest with the right type
AddType application/manifest+json .webmanifest

# Don't cache the page itself so updates show up right away; cache icons for a week
<IfModule mod_headers.c>
  # Pages are never stored and never answered with "not modified": the same address shows the
  # coming-soon page or the full site depending on mode and the preview pass, so a saved copy
  # (and a date check against it) would show the wrong one.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-store"
    Header unset Last-Modified
    Header unset ETag
    RequestHeader unset If-Modified-Since
    RequestHeader unset If-None-Match
  </FilesMatch>
  # The offline helper must be re-checked on every visit so app updates reach phones
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
